# Flask
FLASK_APP=app
FLASK_ENV=production
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32

# Encryption key for Uplynk API keys at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-fernet

# Database
DATABASE_URL=sqlite:////app/data/csl-slicer-console.db

# Bootstrap admin (created on first startup if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# Uplynk v4 API base (usually no need to change)
UPLYNK_API_BASE=https://services.uplynk.com

# Discovery sync interval in minutes (0 = disabled)
DISCOVERY_SYNC_INTERVAL=15

# player-test-harness base URL, for "▶ Player" links on slicer cards (optional)
# PLAYER_BASE_URL=https://player.example.com

# Shared secret the player sends to read slicer settings (/api/slicers/<id>/settings).
# Same value as the player's CSL_API_TOKEN. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PLAYER_API_TOKEN=
# Where this container reaches the player for the channel health badges
# (same token; default PLAYER_BASE_URL). On a shared Docker network:
# PLAYER_API_URL=http://player-test-harness:5000
# Both running locally with docker-compose.local.yml:
# PLAYER_API_URL=http://host.docker.internal:5051

# Single sign-on through an Authentik forward-auth gate in Caddy (optional).
# Caddy sends this secret in X-Authentik-Gate; only then is X-Authentik-Email
# trusted to sign in the console account with that email. Same value as Caddy's
# AUTHENTIK_GATE_SECRET. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTHENTIK_GATE_SECRET=
